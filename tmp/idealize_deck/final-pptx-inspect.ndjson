{"kind":"textbox","id":"sh/tkfapoji","slide":2,"name":"title-2","text":"Planning a trip still means stitching disconnected decisions together.","textPreview":"Planning a trip still means stitching disconnected decisions together.","textChars":70,"textLines":1,"bbox":[48,68,1178,80]}
